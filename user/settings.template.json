{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "opus",
  "effortLevel": "xhigh",
  "fallbackModel": ["claude-sonnet-5"],

  "autoMemoryEnabled": true,
  "alwaysThinkingEnabled": true,

  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6"
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/session-brief.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading session brief..."
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/worker-ledger.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording worker result..."
          }
        ]
      }
    ]
  },

  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  }
}
