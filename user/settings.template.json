{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "model": "opus",
  "effortLevel": "xhigh",

  "minimumVersion": "__MIN_VERSION__",
  "autoUpdatesChannel": "stable",

  "autoMemoryEnabled": true,
  "alwaysThinkingEnabled": true,

  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_MAX_CONCURRENT_SUBAGENTS": "6"
  },

  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/session-brief.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading session brief..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/packet-check.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/worker-ledger.mjs\"",
            "timeout": 10,
            "statusMessage": "Recording worker result..."
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/compact-state.mjs\"",
            "timeout": 15,
            "statusMessage": "Capturing orchestration state..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"__CLAUDE_HOME__/hooks/verify-reminder.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  },

  "permissions": {
    "ask": [
      "Bash(rm -rf *)",
      "Bash(rm -fr *)",
      "Bash(git push --force*)",
      "Bash(git reset --hard*)",
      "Bash(git clean -fd*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./secrets/**)",
      "Read(./**/*.pem)",
      "Read(./**/id_rsa*)"
    ]
  }
}
